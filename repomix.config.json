{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "docs/repomix-map.md",
    "style": "markdown",
    "compress": true,
    "parsableStyle": true,
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "topFilesLength": 10,
    "git": {
      "sortByChanges": false
    }
  },
  "ignore": {
    "customPatterns": [
      "docs/repomix-map.md",
      ".obsidian-kb/**",
      ".github/PULL_REQUEST_TEMPLATE.md",
      ".prism/**",
      "generated/**"
    ]
  }
}
