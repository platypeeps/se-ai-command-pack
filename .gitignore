# `uv venv`/`uv run` write this into whatever directory they are invoked from.
# The repository's dependency interface is requirements-dev.lock via `make
# setup`; a uv lockfile here is a stray artifact of an ad-hoc interpreter run,
# not a second source of truth (see "do not add a package lockfile" in
# docs/spec/backend/directory-structure.md).
uv.lock

# Generated repository map: gitignored, never committed, produced on demand via
# `make repomix` (policy A-025; see docs/spec/backend/quality-guidelines.md).
docs/repomix-map.md

# Agent-tool local state. The tracked platform trees are gone with the framework
# removal, but a local session still writes into the checkout.
.claude/settings.local.json
.claude/**/*.local.*

# Common local secrets and environment files.
.env
.env.*
!.env.example
!.env.ci
!.env.test

# Review/build artifacts.
.build/
code-review-report.json
code-review-report.md

node_modules/

# Generated Obsidian KB copy folder; source docs remain in normal repo paths.
/.obsidian-kb
