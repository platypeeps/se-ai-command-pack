# Coverage configuration for the repo-own coverage floor (task A-020).
# Scope: repo-owned Python only; everything outside `source` is excluded by
# omission. Much of this code runs via subprocess under test
# (install.py, .github/scripts/*), so `parallel` + subprocess bootstrap
# (tests/_coverage_subprocess/sitecustomize.py, activated by
# COVERAGE_PROCESS_START) is required for an honest total.
[run]
source =
    installer
    install
    .github/scripts
parallel = true

[report]
# coverage.py fails when round(total, precision) < fail_under. Pin precision so
# the --fail-under gate semantics are deterministic across environments.
precision = 1
